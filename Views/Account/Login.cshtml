@{
    ViewData["Title"] = "Entrar";
}

<section class="banda banda--crema">
    <div class="contenedor" style="max-width:520px">
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">Entrar</h1>
        <p class="bajada">El panel de Pasear por Pasear.</p>

        @if (ViewBag.Error is string error)
        {
            <p class="aviso aviso--error" role="alert">@error</p>
        }

        <form asp-controller="Account" asp-action="Login" method="post" style="margin-top:32px">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="campo">
                <label for="email">Correo</label>
                <input id="email" name="email" type="email" autocomplete="username" required autofocus />
            </div>

            <div class="campo">
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required />
            </div>

            <button class="boton boton--principal" type="submit">Entrar</button>
        </form>
    </div>
</section>
