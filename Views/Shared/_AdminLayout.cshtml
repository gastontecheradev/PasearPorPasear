@using PasearPorPasear.Services
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Qué página del sitio se está editando: los listados y sus fichas
    // cuelgan de la página donde se publican.
    var paginaActiva = controlador switch
    {
        "Fachadas" => "archivo",
        "Propuestas" => "paseos",
        "ProductosAdmin" => "productos",
        "CarteleraAdmin" => "cartelera",
        "Paginas" when accion == "Sobre" => "sobre",
        "Paginas" => (ViewContext.RouteData.Values["pagina"]?.ToString() ?? "portada").ToLowerInvariant(),
        _ => ""
    };
    string? Activo(string pagina) => paginaActiva == pagina ? "page" : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] — Panel de Pasear por Pasear</title>

    <link rel="preload" href="~/fonts/golos-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/golos-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/marca/favicon.png" asp-append-version="true" />
    <script>document.documentElement.classList.add('con-js');</script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin">

<a class="saltar" href="#contenido">Saltar al contenido</a>

<div class="admin-marco">
    <aside class="admin-lateral">
        <div class="admin-lateral-cabeza">
            <a class="admin-marca" href="/Admin">
                <img src="~/img/marca/casita-sm.webp" alt="" width="120" height="141" />
                <span>Pasear por Pasear <b>Panel</b></span>
            </a>
            <button type="button" class="admin-menu-boton" id="admin-menu-boton"
                    aria-expanded="false" aria-controls="admin-nav">Menú</button>
        </div>

        <nav class="admin-nav" id="admin-nav" aria-label="Secciones del panel">
            <p class="admin-nav-grupo" id="nav-paginas">Páginas del sitio</p>
            <ul aria-labelledby="nav-paginas">
                @foreach (var p in CatalogoTextos.Paginas.Where(p => p.Clave != "general"))
                {
                    <li><a href="@p.UrlPanel" aria-current="@Activo(p.Clave)">@p.Nombre</a></li>
                }
            </ul>

            <p class="admin-nav-grupo" id="nav-todas">En todas las páginas</p>
            <ul aria-labelledby="nav-todas">
                <li><a href="/Admin/Paginas/general" aria-current="@Activo("general")">Menú, pie y enlaces</a></li>
            </ul>

            <div class="admin-nav-pie">
                <a href="/" target="_blank" rel="noopener">Ver el sitio<span class="oculto-visual"> (se abre en otra pestaña)</span></a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="pie-salir">Salir</button>
                </form>
            </div>
        </nav>

        <div class="admin-tejados"><partial name="_Tejados" /></div>
    </aside>

    <main class="admin-cuerpo" id="contenido" tabindex="-1">
        @if (TempData["Success"] is string s1) { <p class="aviso aviso--ok" role="status">@s1</p> }
        @if (TempData["Error"] is string s2) { <p class="aviso aviso--error" role="alert">@s2</p> }
        @if (TempData["Info"] is string s3) { <p class="aviso aviso--info" role="status">@s3</p> }

        @RenderBody()
    </main>
</div>

@* Las páginas del sitio, para elegirlas al poner un enlace en un texto. *@
<script type="application/json" id="paginas-del-sitio">@Json.Serialize(CatalogoTextos.Paginas
    .Where(p => p.UrlPublica is not null)
    .Select(p => new { nombre = p.Nombre, dir = p.UrlPublica }))</script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
