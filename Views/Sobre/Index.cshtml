@model SobreVm
@{
}

<section class="banda banda--crema" aria-labelledby="sobre-proyecto">
    <div class="contenedor">
        <div class="duo">
            <div>
                <div class="regla regla--izq"><partial name="_Flor" /></div>
                <h1 class="titulo-seccion" id="sobre-proyecto">@Model.Titulo</h1>
                <div class="texto" style="margin-top:20px">
                    @Html.Raw(PasearPorPasear.Services.TextoConFormato.Parrafos(Model.Contenido))
                </div>
                <p class="atributos" style="color:var(--petroleo)">
                    @Textos["general.atributo-1"]
                    <partial name="_Flor" />
                    @Textos["general.atributo-2"]
                    <partial name="_Flor" />
                    @Textos["general.atributo-3"]
                </p>
            </div>
            @if (!string.IsNullOrEmpty(Model.ProyectoImagenSrc))
            {
                <div class="columna-retrato columna-retrato--der">
                    <div class="retrato">
                        <img src="@Model.ProyectoImagenSrc" alt="@Model.Pagina.ProyectoImagenAlt" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ContenidoAutora))
{
    <section class="banda banda--crema2" aria-labelledby="sobre-autora">
        <div class="contenedor">
            <div class="duo">
                @if (!string.IsNullOrEmpty(Model.ImagenSrc))
                {
                    <div class="columna-retrato">
                        <div class="retrato">
                            <img src="@Model.ImagenSrc" alt="@Model.Pagina.ImagenAlt" />
                        </div>
                    </div>
                }
                <div>
                    <h2 class="titulo-seccion" id="sobre-autora">@Model.Pagina.Firma</h2>
                    <div class="texto" style="margin-top:20px">
                        @Html.Raw(PasearPorPasear.Services.TextoConFormato.Parrafos(Model.ContenidoAutora))
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<div class="transicion" style="background:@(string.IsNullOrWhiteSpace(Model.ContenidoAutora) ? "var(--crema)" : "var(--crema-2)")"><partial name="_Onda" model="@("var(--petroleo)")" /></div>

<section class="banda banda--petroleo banda--ajustada" style="padding-top:calc(var(--aire) * .35)">
    <div class="contenedor">
        <div class="suscripcion">
            <div>
                <h2 class="titulo-seccion" style="font-size:var(--t-xl)">@Textos["sobre.colaborar-titulo"]</h2>
                @if (Textos["sobre.colaborar-texto"] is { Length: > 0 })
                {
                    <p class="bajada">@Textos.ConEnlaces("sobre.colaborar-texto")</p>
                }
                @if (Textos.Enlace("sobre.colaborar-enlace") is string pago)
                {
                    <div class="acciones">
                        <a class="boton boton--claro" href="@pago" target="_blank" rel="noopener">@Textos["sobre.colaborar-boton"]</a>
                    </div>
                }
            </div>
            <img class="kiosco" src="~/img/marca/kiosquito.webp" alt="" width="320" height="315" loading="lazy" />
        </div>
    </div>
</section>
