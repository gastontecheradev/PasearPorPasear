@model Producto
@{
    Layout = "_AdminLayout";
    var esNuevo = Model.Id == 0;
    var sello = Model.ActualizadoEn ?? Model.CreadoEn;
    var cargada = Model.ImagenDatos is { Length: > 0 };

    var campoTitulo = new CamposIdiomaVm
    {
        Nombre = "Titulo", Etiqueta = "Nombre", Maximo = 160,
        Es = Model.Titulo, En = Model.TituloEn, Pt = Model.TituloPt
    };
    var campoDescripcion = new CamposIdiomaVm
    {
        Nombre = "Descripcion", Etiqueta = "Descripción", Largo = true, Maximo = 600,
        Es = Model.Descripcion, En = Model.DescripcionEn, Pt = Model.DescripcionPt,
        Pista = "Dos o tres líneas. Hasta 600 caracteres."
    };
    var campoImagen = new CampoImagenVm
    {
        Src = cargada ? $"/Imagenes/Producto/{Model.Id}?v={sello.Ticks}" : Model.ImagenUrl,
        Alt = Model.ImagenAlt,
        EsCargada = cargada,
        Titulo = "Ilustración"
    };
    // Las muestras usan los mismos colores que el fondo de la tarjeta pública
    // (.producto--*). «Rayas» es un nombre viejo del enum: se ve piedra.
    var colores = new (ColorAfiche Valor, string Nombre, string Muestra)[]
    {
        (ColorAfiche.Mostaza, "Mostaza", "var(--mostaza)"),
        (ColorAfiche.Durazno, "Durazno", "var(--durazno)"),
        (ColorAfiche.Rayas, "Piedra", "var(--piedra)"),
        (ColorAfiche.Petroleo, "Petróleo", "var(--petroleo)"),
        (ColorAfiche.Crema, "Crema", "var(--crema-2)")
    };
    var barra = new BarraGuardarVm
    {
        TextoGuardar = esNuevo ? "Crear el producto" : "Guardar cambios",
        UrlVolver = "/Admin/Productos"
    };
    var borrar = new ZonaBorrarVm
    {
        Url = $"/Admin/Productos/Borrar/{Model.Id}",
        Nombre = Model.Titulo,
        Texto = "Borrar el producto",
        Explicacion = "Sale del catálogo y de la base. No se puede deshacer; para sacarlo un tiempo, ocultalo."
    };
}

<header class="admin-titulo">
    <div>
        <nav class="admin-miga" aria-label="Estás en">
            <a href="/Admin/Productos">Productos</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@(esNuevo ? "Nuevo" : Model.Titulo)</span>
        </nav>
        <h1>@(esNuevo ? "Producto nuevo" : Model.Titulo)</h1>
        <p><a href="/Productos" target="_blank" rel="noopener">Ver el catálogo en el sitio<span class="oculto-visual"> (se abre en otra pestaña)</span></a></p>
    </div>
</header>

<form method="post" action="/Admin/Productos/Guardar" enctype="multipart/form-data" data-editor>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div asp-validation-summary="All" class="aviso aviso--error" role="alert"></div>

    <partial name="_SelectorIdioma" />

    <div class="admin-form">
        <div class="admin-principal">
            <section class="admin-seccion">
                <h2>El producto</h2>
                <p>Lo que se lee en la tarjeta del catálogo.</p>
                <partial name="_CamposIdioma" model="campoTitulo" />
                <partial name="_CamposIdioma" model="campoDescripcion" />
            </section>

            <section class="admin-seccion">
                <h2>Color de fondo</h2>
                <p>El panel de color que va detrás de la ilustración.</p>
                <fieldset class="muestras">
                    <legend class="oculto-visual">Color del panel</legend>
                    @foreach (var c in colores)
                    {
                        <label>
                            <input type="radio" name="ColorPanel" value="@((int)c.Valor)" checked="@(Model.ColorPanel == c.Valor)" />
                            <span class="muestra" style="background:@c.Muestra"></span>
                            @c.Nombre
                        </label>
                    }
                </fieldset>
            </section>

            <section class="admin-seccion">
                <h2>Descarga</h2>
                <p>Sólo para los productos gratis, como la cartelera imprimible.</p>
                <div class="campo">
                    <label for="ArchivoUrl">Dirección del archivo</label>
                    <input id="ArchivoUrl" name="ArchivoUrl" type="text" value="@Model.ArchivoUrl" maxlength="500" />
                    <p class="pista">Por ejemplo /descargas/cartelera-a5.pdf, con el PDF dentro de wwwroot.</p>
                </div>
            </section>
        </div>

        <div class="admin-lado">
            <section class="admin-panel">
                <h2>Venta</h2>
                <p>Mientras esté en preparación no se muestra precio.</p>

                <fieldset class="conmutador">
                    <legend>¿Se ve en el catálogo?</legend>
                    <div class="conmutador-opciones">
                        <label><input type="radio" name="Visible" value="false" checked="@(!Model.Visible)" /> Oculto</label>
                        <label><input type="radio" name="Visible" value="true" checked="@Model.Visible" /> Visible</label>
                    </div>
                </fieldset>

                <div class="campo">
                    <label for="Estado">Estado</label>
                    <select id="Estado" name="Estado">
                        <option value="@((int)EstadoProducto.EnPreparacion)" selected="@(Model.Estado == EstadoProducto.EnPreparacion)">En preparación</option>
                        <option value="@((int)EstadoProducto.ALaVenta)" selected="@(Model.Estado == EstadoProducto.ALaVenta)">A la venta</option>
                        <option value="@((int)EstadoProducto.DescargaGratis)" selected="@(Model.Estado == EstadoProducto.DescargaGratis)">Descarga gratis</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="Precio">Precio en pesos</label>
                    <input id="Precio" name="Precio" type="number" step="1" min="0"
                           value="@(Model.Precio?.ToString("0"))" />
                    <p class="pista">Obligatorio si está a la venta.</p>
                </div>

                <div class="campo">
                    <label for="Orden">Orden en el catálogo</label>
                    <input id="Orden" name="Orden" type="number" value="@Model.Orden" />
                    <p class="pista">Más chico, más arriba.</p>
                </div>
            </section>

            <partial name="_CampoImagen" model="campoImagen" />

            @if (!esNuevo)
            {
                <partial name="_ZonaBorrar" model="borrar" />
            }
        </div>
    </div>

    <partial name="_BarraGuardar" model="barra" />
</form>
