@model InicioVm
@{
    var esIngles = Model.Idioma == "en";
    var esPortugues = Model.Idioma == "pt";
}

<section class="portada">
    <div class="portada-int">
        <h1 class="oculto-visual">Pasear por Pasear</h1>
        <img class="lettering-grande" src="~/img/marca/wordmark-petroleo.webp"
             alt="Pasear por Pasear" width="720" height="307" />
        <p class="frase">@Model.TituloSeccion</p>
        @if (!string.IsNullOrEmpty(Model.BajadaSeccion))
        {
            <p class="entrada">@Model.BajadaSeccion</p>
        }
        <div class="acciones">
            <a class="boton boton--principal" href="/Paseos">@(esPortugues ? "Vamos passear?" : esIngles ? "Shall we walk?" : "¿Paseamos?")</a>
            <a class="boton boton--borde" href="/Archivo">@(esPortugues ? "Ver o arquivo" : esIngles ? "See the archive" : "Ver el archivo")</a>
        </div>
    </div>
</section>

<div class="horizonte">
    <img class="gorrion" src="~/img/marca/gorrion.webp" alt="" width="380" height="307" />
    <partial name="_Tejados" />
</div>

@* ── Qué es Pasear por Pasear ── *@
@if (Model.Definicion is not null)
{
<section class="banda banda--petroleo" style="padding-top:calc(var(--aire) * .5)">
    <div class="contenedor">
        <div class="definicion">
            <div>
                <h2 class="titulo-seccion">@Model.T(Model.Definicion.Titulo, Model.Definicion.TituloEn, Model.Definicion.TituloPt)</h2>
                <div class="texto" style="margin-top:22px;color:var(--tinta-clara)">
                    @Html.Raw(Model.TO(Model.Definicion.Bajada, Model.Definicion.BajadaEn, Model.Definicion.BajadaPt))
                </div>
                <p class="atributos">
                    @(esPortugues ? "Movimento" : esIngles ? "Movement" : "Movimiento")
                    <partial name="_Flor" />
                    @(esPortugues ? "Curiosidade" : esIngles ? "Curiosity" : "Curiosidad")
                    <partial name="_Flor" />
                    @(esPortugues ? "Identidade" : esIngles ? "Identity" : "Identidad")
                </p>
                <div class="acciones">
                    <a class="boton boton--claro" href="/Sobre">@(esPortugues ? "Sobre PPP" : esIngles ? "About PPP" : "Sobre PPP")</a>
                </div>
            </div>
            <img class="casita-grande" src="~/img/marca/casita.webp" alt="" width="380" height="447" />
        </div>
    </div>
</section>

<div class="transicion" style="background:var(--petroleo)"><partial name="_Onda" model="@("var(--durazno)")" /></div>
}
else
{
    <div class="transicion" style="background:var(--crema)"><partial name="_Onda" model="@("var(--durazno)")" /></div>
}

<section class="banda banda--durazno banda--ajustada" style="padding-top:calc(var(--aire) * .35)">
    <div class="contenedor">
        <div class="suscripcion">
            <partial name="_BloqueBuzon" model="Model.Buzon" />
            <img class="kiosco" src="~/img/marca/kiosquito.webp" alt="" width="320" height="315" loading="lazy" />
        </div>
    </div>
</section>
