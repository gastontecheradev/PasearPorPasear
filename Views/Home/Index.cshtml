@model InicioVm
@{
    var esIngles = Model.Idioma == "en";
    var esPortugues = Model.Idioma == "pt";
}

<section class="portada">
    <div class="portada-int">
        <h1 class="oculto-visual">Pasear por Pasear</h1>
        <img class="lettering-grande" src="~/img/marca/wordmark-petroleo.webp"
             alt="Pasear por Pasear" width="720" height="307" />
        <p class="frase">@Model.TituloSeccion</p>
        @if (!string.IsNullOrEmpty(Model.BajadaSeccion))
        {
            <p class="entrada">@Model.BajadaSeccion</p>
        }
        <div class="acciones">
            <a class="boton boton--principal" href="/Paseos">@(esPortugues ? "Passeia comigo" : esIngles ? "Walk with me" : "Paseá conmigo")</a>
            <a class="boton boton--borde" href="/Archivo">@(esPortugues ? "Ver o arquivo" : esIngles ? "See the archive" : "Ver el archivo")</a>
        </div>
    </div>
</section>

<div class="horizonte">
    <img class="gorrion" src="~/img/marca/gorrion.webp" alt="" width="380" height="307" />
    <partial name="_Tejados" />
</div>

@* ── Qué es Pasear por Pasear ── *@
@if (Model.Definicion is not null)
{
<section class="banda banda--petroleo" style="padding-top:calc(var(--aire) * .5)">
    <div class="contenedor">
        <div class="definicion">
            <div>
                <h2 class="titulo-seccion">@Model.T(Model.Definicion.Titulo, Model.Definicion.TituloEn, Model.Definicion.TituloPt)</h2>
                <div class="texto" style="margin-top:22px;color:var(--tinta-clara)">
                    @Html.Raw(Model.TO(Model.Definicion.Bajada, Model.Definicion.BajadaEn, Model.Definicion.BajadaPt))
                </div>
                <p class="atributos">
                    @(esPortugues ? "Cotidiano" : esIngles ? "Everyday" : "Cotidiano")
                    <partial name="_Flor" />
                    @(esPortugues ? "Caloroso" : esIngles ? "Warm" : "Cálido")
                    <partial name="_Flor" />
                    @(esPortugues ? "Orgânico" : esIngles ? "Organic" : "Orgánico")
                </p>
            </div>
            <img class="casita-grande" src="~/img/marca/casita.webp" alt="" width="380" height="447" />
        </div>
    </div>
</section>

<div class="transicion" style="background:var(--petroleo)"><partial name="_Onda" model="@("var(--crema)")" /></div>
}

@* ── Los cuatro pilares ── *@
<section class="banda banda--crema" style="padding-top:calc(var(--aire) * .5)">
    <div class="contenedor">
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h2 class="titulo-seccion">@(esPortugues ? "Por onde quer começar?" : esIngles ? "Where do you want to start?" : "¿Por dónde querés empezar?")</h2>
        <p class="bajada">@(esPortugues ? "Há quatro maneiras de entrar nisto. Nenhuma é melhor que outra." : esIngles ? "There are four ways into this. None is better than the others." : "Hay cuatro maneras de meterse en esto. Ninguna es mejor que otra.")</p>

        <div class="pilares" style="margin-top:48px">
            <a class="pilar pilar--mostaza" href="/Paseos">
                <div class="pilar-imagen"><img src="~/img/marca/casita.webp" alt="" width="380" height="447" loading="lazy" /></div>
                <div class="pilar-cuerpo">
                    <h3>@(esPortugues ? "Passeia comigo?" : esIngles ? "Walk with me?" : "¿Paseás conmigo?")</h3>
                    <p>@(esPortugues ? "El Clubcito, percursos criativos e saídas montadas sob encomenda." : esIngles ? "El Clubcito, creative walks and outings built on request." : "El Clubcito, recorridos creativos y salidas armadas a pedido.")</p>
                    <span class="ver">@(esPortugues ? "Ver as quatro propostas" : esIngles ? "See the four offerings" : "Ver las cuatro propuestas")</span>
                </div>
            </a>

            <a class="pilar pilar--durazno" href="/Archivo">
                <div class="pilar-imagen"><img src="~/img/marca/ventana-1.webp" alt="" width="280" height="474" loading="lazy" /></div>
                <div class="pilar-cuerpo">
                    <h3>#ArchivoDeFachadas</h3>
                    <p>@(esPortugues ? "O arquivo das casas de Montevidéu, com sua rua, seu bairro e sua data." : esIngles ? "The archive of Montevideo's houses, with street, neighbourhood and date." : "El archivo de las casas de Montevideo, con su calle, su barrio y su fecha.")</p>
                    <span class="ver">@(esPortugues ? "Entrar no arquivo" : esIngles ? "Enter the archive" : "Entrar al archivo")</span>
                </div>
            </a>

            <a class="pilar pilar--crema2" href="/Productos">
                <div class="pilar-imagen"><img src="~/img/marca/ventana-2.webp" alt="" width="300" height="379" loading="lazy" /></div>
                <div class="pilar-cuerpo">
                    <h3>@(esPortugues ? "Produtos" : esIngles ? "Shop" : "Productos")</h3>
                    <p>@(esPortugues ? "As ilustrações da marca, impressas. Ainda não saíram à venda." : esIngles ? "The brand illustrations, printed. Not on sale yet." : "Las ilustraciones de la marca, impresas. Todavía no salieron a la venta.")</p>
                    <span class="ver">@(esPortugues ? "Ver o que vem" : esIngles ? "See what is coming" : "Ver lo que viene")</span>
                </div>
            </a>

            <a class="pilar pilar--piedra" href="/Cartelera">
                <div class="pilar-imagen"><img src="~/img/marca/kiosquito.webp" alt="" width="320" height="315" loading="lazy" /></div>
                <div class="pilar-cuerpo">
                    <h3>@(esPortugues ? "Mural do bairro" : esIngles ? "Neighbourhood board" : "Cartelera de barrio")</h3>
                    <p>@(esPortugues ? "Uma parede para colar seu cartaz. Eventos, ofícios e pedidos de ajuda." : esIngles ? "A wall to put your poster up. Events, trades and requests for help." : "Una pared para pegar tu afiche. Eventos, oficios y pedidos de ayuda.")</p>
                    <span class="ver">@(esPortugues ? "Ver o mural" : esIngles ? "See the board" : "Ver la cartelera")</span>
                </div>
            </a>
        </div>
    </div>
</section>

@if (Model.TiraArchivo.Count > 0)
{
    <div class="transicion" style="background:var(--crema)"><partial name="_Onda" model="@("var(--crema-2)")" /></div>

    <section class="banda banda--crema2" style="padding-top:calc(var(--aire) * .5)">
        <div class="contenedor">
            <div class="regla regla--izq"><partial name="_Flor" /></div>
            <h2 class="titulo-seccion">#ArchivoDeFachadas</h2>
            <div class="archivo-tira" style="margin-top:38px">
                @foreach (var f in Model.TiraArchivo)
                {
                    <a href="@f.Url"><img src="@f.ImagenSrc" alt="@f.ImagenAlt" loading="lazy" /></a>
                }
            </div>
            <div class="acciones">
                <a class="boton boton--borde" href="/Archivo">@(esPortugues ? "Entrar no arquivo completo" : esIngles ? "Enter the full archive" : "Entrar al archivo completo")</a>
            </div>
        </div>
    </section>
}

@if (Model.Afiches.Count > 0)
{
    <div class="transicion" style="background:var(--crema-2)"><partial name="_Onda" model="@("var(--mostaza)")" /></div>

    <section class="banda banda--mostaza" style="padding-top:calc(var(--aire) * .5)">
        <div class="contenedor">
            <div class="regla regla--izq" style="color:var(--petroleo)"><partial name="_Flor" /></div>
            <h2 class="titulo-seccion">@(esPortugues ? "O mural do bairro" : esIngles ? "The neighbourhood board" : "La cartelera de barrio")</h2>
            <div class="muro" style="margin-top:48px">
                @foreach (var a in Model.Afiches)
                {
                    <partial name="_Afiche" model="a" />
                }
            </div>
            <div class="acciones" style="margin-top:50px">
                <a class="boton boton--principal" href="/Cartelera">@(esPortugues ? "Como colar seu cartaz" : esIngles ? "How to put your poster up" : "Cómo pegar tu afiche")</a>
            </div>
        </div>
    </section>
}

@if (Model.Sobre is not null)
{
    <div class="transicion" style="background:var(--mostaza)"><partial name="_Onda" model="@("var(--crema)")" /></div>

    <section class="banda banda--crema" style="padding-top:calc(var(--aire) * .5)">
        <div class="contenedor">
            <div class="duo">
                <div>
                    <div class="regla regla--izq"><partial name="_Flor" /></div>
                    <h2 class="titulo-seccion">@(esPortugues ? "Atrás de tudo isto há uma pessoa" : esIngles ? "There is a person behind all this" : "Atrás de todo esto hay una persona")</h2>
                    <div class="texto" style="margin-top:20px">
                        @Html.Raw(Model.T(Model.Sobre.Contenido, Model.Sobre.ContenidoEn, Model.Sobre.ContenidoPt))
                    </div>
                    <p class="firma">@Model.Sobre.Firma</p>
                    <div class="acciones">
                        <a class="boton boton--borde" href="/Sobre">@(esPortugues ? "Ler a história completa" : esIngles ? "Read the full story" : "Leer la historia completa")</a>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.SobreImagenSrc))
                {
                    <div class="columna-retrato">
                        <div class="retrato">
                            <img src="@Model.SobreImagenSrc" alt="@Model.Sobre.ImagenAlt" loading="lazy" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<div class="transicion" style="background:var(--crema)"><partial name="_Onda" model="@("var(--durazno)")" /></div>

<section class="banda banda--durazno banda--ajustada" style="padding-top:calc(var(--aire) * .35)">
    <div class="contenedor">
        <div class="suscripcion">
            <partial name="_BloqueBuzon" model="Model.Buzon" />
            <img class="kiosco" src="~/img/marca/kiosquito.webp" alt="" width="320" height="315" loading="lazy" />
        </div>
    </div>
</section>
