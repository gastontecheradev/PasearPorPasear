@model ContactoVm
@{
    var esIngles = Model.Idioma == "en";
    var esPortugues = Model.Idioma == "pt";
}

<section class="encabezado banda--crema">
    <div class="contenedor">
        <img class="adorno" src="~/img/marca/ventana-3.webp" alt="" width="300" height="417" />
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">@Model.TituloSeccion</h1>
        @if (!string.IsNullOrEmpty(Model.BajadaSeccion))
        {
            <p class="bajada">@Model.BajadaSeccion</p>
        }
    </div>
</section>

<section class="banda banda--crema" style="padding-top:0">
    <div class="contenedor">
        <div class="contacto">
            @* Suscripción al buzón: formulario de MailerLite embebido (trae su propio título y texto). *@
            <div id="buzon" class="formulario-externo">
                <iframe src="https://preview.mailerlite.io/forms/2403548/193692652342872057/share"
                        loading="lazy"
                        title="@(esPortugues ? "Formulário de inscrição na caixa de correio da Casita" : esIngles ? "Sign-up form for the Casita mailbox" : "Formulario de suscripción al buzón de la Casita")"></iframe>
            </div>

            <ul class="datos">
                <li>
                    <strong>@(esPortugues ? "E-mail" : esIngles ? "Email" : "Correo")</strong>
                    <a href="mailto:@Model.CorreoContacto">@Model.CorreoContacto</a>
                </li>
                <li>
                    <strong>Instagram</strong>
                    <a href="https://www.instagram.com/pasearporpasear/" target="_blank" rel="noopener">@@pasearporpasear</a>
                </li>
                @if (!string.IsNullOrEmpty(Model.CanalWhatsApp))
                {
                    <li>
                        <strong>WhatsApp</strong>
                        <a href="@Model.CanalWhatsApp" target="_blank" rel="noopener">@(esPortugues ? "Canal do WhatsApp" : esIngles ? "WhatsApp channel" : "Canal de WhatsApp")</a>
                    </li>
                }
                <li>
                    <strong>@(esPortugues ? "Onde estamos" : esIngles ? "Where we are" : "Dónde estamos")</strong>
                    Montevideo, Uruguay
                </li>
            </ul>
        </div>
    </div>
</section>