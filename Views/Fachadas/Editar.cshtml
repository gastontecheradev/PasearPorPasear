@model Fachada
@{
    Layout = "_AdminLayout";
    var esNueva = Model.Id == 0;
    var sello = Model.ActualizadaEn ?? Model.CreadaEn;
    var cargada = Model.ImagenDatos is { Length: > 0 };

    // Los modelos de los parciales se arman acá: un inicializador multilínea
    // dentro del atributo de un tag helper es frágil en Razor.
    var campoTitulo = new CamposIdiomaVm
    {
        Nombre = "Titulo", Etiqueta = "Título", Maximo = 200,
        Es = Model.Titulo, En = Model.TituloEn, Pt = Model.TituloPt,
        Pista = "Suele ser la esquina o la dirección: «Rivera casi Comercio»."
    };
    var campoExtracto = new CamposIdiomaVm
    {
        Nombre = "Extracto", Etiqueta = "Extracto", Largo = true, Maximo = 600,
        Es = Model.Extracto, En = Model.ExtractoEn, Pt = Model.ExtractoPt,
        Pista = "Una o dos líneas, debajo de la foto. Hasta 600 caracteres."
    };
    var campoContenido = new CamposIdiomaVm
    {
        Nombre = "Contenido", Etiqueta = "La ficha completa", Largo = true,
        Es = Model.Contenido, En = Model.ContenidoEn, Pt = Model.ContenidoPt,
        Pista = "Admite HTML: cada párrafo entre etiquetas <p> y </p>."
    };
    var campoImagen = new CampoImagenVm
    {
        Src = cargada ? $"/Imagenes/Fachada/{Model.Id}?v={sello.Ticks}" : Model.ImagenUrl,
        Alt = Model.ImagenAlt,
        EsCargada = cargada,
        Titulo = "Foto de la fachada"
    };
    var barra = new BarraGuardarVm
    {
        TextoGuardar = esNueva ? "Crear la ficha" : "Guardar cambios",
        UrlVolver = "/Admin/Fachadas"
    };
    var borrar = new ZonaBorrarVm
    {
        Url = $"/Admin/Fachadas/Borrar/{Model.Id}",
        Nombre = Model.Titulo,
        Texto = "Borrar la ficha",
        Explicacion = "Sale del archivo y de la base. No se puede deshacer; si sólo querés sacarla un tiempo, pasala a borrador."
    };
}

<header class="admin-titulo">
    <div>
        <nav class="admin-miga" aria-label="Estás en">
            <a href="/Admin/Fachadas">#ArchivoDeFachadas</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@(esNueva ? "Nueva" : $"N.º {Model.Numero}")</span>
        </nav>
        <h1>@(esNueva ? "Fachada nueva" : Model.Titulo)</h1>
        <p>
            @if (esNueva)
            {
                <text>Va a quedar como ficha N.º @Model.Numero del archivo.</text>
            }
            else
            {
                <a href="/Archivo/Ficha/@Model.Slug" target="_blank" rel="noopener">Ver la ficha en el sitio<span class="oculto-visual"> (se abre en otra pestaña)</span></a>
            }
        </p>
    </div>
</header>

<form method="post" action="/Admin/Fachadas/Guardar" enctype="multipart/form-data" data-editor>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div asp-validation-summary="All" class="aviso aviso--error" role="alert"></div>

    <partial name="_SelectorIdioma" />

    <div class="admin-form">
        <div class="admin-principal">
            <section class="admin-seccion">
                <h2>Dónde está</h2>
                <p>Lo que aparece en el listado del archivo y arriba de la ficha.</p>

                <partial name="_CamposIdioma" model="campoTitulo" />

                <div class="admin-fila">
                    <div class="campo">
                        <label for="Barrio">Barrio</label>
                        <input id="Barrio" name="Barrio" type="text" value="@Model.Barrio" required maxlength="120" />
                    </div>
                    <div class="campo">
                        <label for="Calle">Calle</label>
                        <input id="Calle" name="Calle" type="text" value="@Model.Calle" maxlength="200" />
                    </div>
                </div>
            </section>

            <section class="admin-seccion">
                <h2>El texto</h2>
                <p>El extracto va debajo de la foto principal; después viene la ficha completa.</p>
                <partial name="_CamposIdioma" model="campoExtracto" />
                <partial name="_CamposIdioma" model="campoContenido" />
            </section>

            <section class="admin-seccion">
                <h2>Mapa</h2>
                <p>Opcional. En Google Maps: Compartir, Insertar un mapa, y copiar sólo la dirección que está dentro de src="…".</p>
                <div class="campo">
                    <label for="MapaEmbedUrl">Dirección del mapa</label>
                    <input id="MapaEmbedUrl" name="MapaEmbedUrl" type="url" value="@Model.MapaEmbedUrl" maxlength="600"
                           placeholder="https://www.google.com/maps/embed?pb=…" />
                </div>
            </section>
        </div>

        <div class="admin-lado">
            <section class="admin-panel">
                <h2>Publicación</h2>
                <p>En borrador, la ficha no se ve en el sitio.</p>

                <fieldset class="conmutador">
                    <legend>¿Se ve en el archivo?</legend>
                    <div class="conmutador-opciones">
                        <label><input type="radio" name="Publicada" value="false" checked="@(!Model.Publicada)" /> Borrador</label>
                        <label><input type="radio" name="Publicada" value="true" checked="@Model.Publicada" /> Publicada</label>
                    </div>
                </fieldset>

                <div class="campo">
                    <label for="Numero">Número de ficha</label>
                    <input id="Numero" name="Numero" type="number" min="1" value="@Model.Numero" required />
                </div>

                <div class="campo">
                    <label for="FechaEncontrada">La encontré el</label>
                    <input id="FechaEncontrada" name="FechaEncontrada" type="date"
                           value="@Model.FechaEncontrada.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="campo">
                    <label for="FechaPublicacion">Fecha de publicación</label>
                    <input id="FechaPublicacion" name="FechaPublicacion" type="date"
                           value="@Model.FechaPublicacion.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="campo">
                    <label for="AnioConstruccion">Año de construcción</label>
                    <input id="AnioConstruccion" name="AnioConstruccion" type="number" min="1700" max="2100"
                           value="@(Model.AnioConstruccion?.ToString())" />
                    <p class="pista">Opcional.</p>
                </div>
            </section>

            <partial name="_CampoImagen" model="campoImagen" />

            @if (!esNueva)
            {
                <partial name="_ZonaBorrar" model="borrar" />
            }
        </div>
    </div>

    <partial name="_BarraGuardar" model="barra" />
</form>
