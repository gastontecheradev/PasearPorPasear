@page "{id:int}"
@model PasearPorPasear.Pages.Posts.DeleteModel

<h2>Eliminar Publicación</h2>

<p>¿Estás seguro de que deseas eliminar la publicación titulada <strong>@Model.Post.Titulo</strong>?</p>

<form method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>
