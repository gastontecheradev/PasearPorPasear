@model BuzonVm
@*
    Suscripción al buzón de la Casita. Aparece en varias páginas; la
    suscripción se hace en el formulario de MailerLite.
*@
<div class="@(Model.Clase ?? "")">
    <h2 class="titulo-seccion" style="font-size:var(--t-xl)">@Model.Titulo</h2>
    @if (!string.IsNullOrEmpty(Model.Texto))
    {
        <p style="max-width:46ch;margin-top:12px">@Model.Texto</p>
    }
    <div class="acciones" style="margin-top:22px">
        @if (Model.Enlace.StartsWith("http"))
        {
            <a class="boton @Model.ClaseBoton" href="@Model.Enlace" target="_blank" rel="noopener">@Model.EtiquetaBoton</a>
        }
        else
        {
            <a class="boton @Model.ClaseBoton" href="@Model.Enlace">@Model.EtiquetaBoton</a>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Nota))
    {
        <p class="nota">@Model.Nota</p>
    }
</div>
