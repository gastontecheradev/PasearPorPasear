@model PasearPorPasear.ViewModels.CampoImagenVm
@*
    Imagen actual y reemplazo. Las imágenes se guardan en la base:
    el aviso de peso no es decorativo, el límite son 6 MB por archivo.
    admin.js muestra la imagen elegida antes de guardar y frena las
    que pasan el límite sin esperar al servidor.
*@
<section class="admin-panel" data-imagen>
    <h2>@Model.Titulo</h2>
    <p>Lo que se ve en el sitio.</p>

    <div class="admin-imagen" data-imagen-vista>
        @if (!string.IsNullOrEmpty(Model.Src))
        {
            <img src="@Model.Src" alt="" />
            <span class="origen">@(Model.EsCargada ? "Cargada desde el panel" : "Imagen de arranque del sitio")</span>
        }
        else
        {
            <div class="sin-imagen">Todavía sin imagen</div>
        }
    </div>

    <div class="campo campo-archivo">
        <label for="@Model.CampoArchivo">@(string.IsNullOrEmpty(Model.Src) ? "Elegir una imagen" : "Cambiar por otra")</label>
        <input id="@Model.CampoArchivo" name="@Model.CampoArchivo" type="file"
               accept="image/jpeg,image/png,image/webp,image/gif" data-imagen-archivo />
        <p class="campo-error" data-imagen-error role="alert" hidden></p>
        <p class="pista">JPG, PNG, WEBP o GIF, hasta 6 MB. Conviene achicarla antes: ocupa lugar en la base.</p>
    </div>

    <div class="campo">
        <label for="@Model.CampoAlt">Qué se ve en la foto</label>
        <input id="@Model.CampoAlt" name="@Model.CampoAlt" type="text" value="@Model.Alt" maxlength="300" />
        <p class="pista">Lo leen quienes usan lector de pantalla.</p>
    </div>

    @if (Model.EsCargada)
    {
        <label class="casilla">
            <input type="checkbox" name="@Model.CampoBorrar" value="true" />
            <span>Quitar la imagen cargada<small>Vuelve la imagen de arranque, si había una.</small></span>
        </label>
    }
</section>
