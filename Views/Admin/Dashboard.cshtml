@model PasearPorPasear.Controllers.AdminController.TableroVm
@{
    ViewData["Title"] = "Panel";
}

<section class="banda banda--crema">
    <div class="contenedor">
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">Panel</h1>
        <p class="bajada">Cómo está el sitio hoy.</p>

        <div class="contador" style="max-width:none;margin-block:40px">
            <div><b>@Model.Fachadas</b><span>fachadas publicadas</span></div>
            <div><b>@Model.ProximosEncuentros</b><span>encuentros por venir</span></div>
            <div><b>@Model.AfichesPublicados</b><span>afiches en la cartelera</span></div>
            <div><b>@Model.SuscriptoresBuzon</b><span>en el buzón</span></div>
        </div>

        @if (Model.AfichesPorRevisar > 0 || Model.MensajesSinLeer > 0 || Model.ConsultasPendientes > 0)
        {
            <h2 style="font-size:var(--t-xl);margin-bottom:16px">Esperando tu respuesta</h2>
            <ul class="datos" style="max-width:560px">
                @if (Model.AfichesPorRevisar > 0)
                {
                    <li><strong>Cartelera</strong>@Model.AfichesPorRevisar afiche(s) por revisar</li>
                }
                @if (Model.MensajesSinLeer > 0)
                {
                    <li><strong>Contacto</strong>@Model.MensajesSinLeer mensaje(s) sin leer</li>
                }
                @if (Model.ConsultasPendientes > 0)
                {
                    <li><strong>Paseos</strong>@Model.ConsultasPendientes consulta(s) pendiente(s)</li>
                }
            </ul>
        }
        else
        {
            <p class="bajada">No hay nada pendiente.</p>
        }

        <div class="recuadro" style="background:var(--crema-2);margin-top:44px">
            <h2>Las pantallas de edición están en camino</h2>
            <p>Por ahora el contenido se carga desde la base. Las altas y ediciones
               de fachadas, encuentros, afiches y productos llegan en la próxima entrega.</p>
        </div>
    </div>
</section>
