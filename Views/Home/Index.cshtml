@model InicioVm
@{
    var definicionTitulo = Textos["portada.definicion-titulo"];
    var entrada = Textos["portada.entrada"];
}

<section class="portada">
    <div class="portada-int">
        <h1 class="oculto-visual">Pasear por Pasear</h1>
        <img class="lettering-grande" src="~/img/marca/wordmark-petroleo.webp"
             alt="Pasear por Pasear" width="720" height="307" />
        <p class="frase">@Textos["portada.frase"]</p>
        @if (!string.IsNullOrEmpty(entrada))
        {
            <p class="entrada">@entrada</p>
        }
        <div class="acciones">
            <a class="boton boton--principal" href="/Paseos">@Textos["portada.boton-paseos"]</a>
            <a class="boton boton--borde" href="/Archivo">@Textos["portada.boton-archivo"]</a>
        </div>
    </div>
</section>

<div class="horizonte">
    <img class="gorrion" src="~/img/marca/gorrion.webp" alt="" width="380" height="307" />
    <partial name="_Tejados" />
</div>

@* ── Qué es Pasear por Pasear ── *@
@if (!string.IsNullOrEmpty(definicionTitulo))
{
<section class="banda banda--petroleo" style="padding-top:calc(var(--aire) * .5)">
    <div class="contenedor">
        <div class="definicion">
            <div>
                <h2 class="titulo-seccion">@definicionTitulo</h2>
                <div class="texto" style="margin-top:22px;color:var(--tinta-clara)">
                    @Textos.Html("portada.definicion-texto")
                </div>
                <p class="atributos">
                    @Textos["general.atributo-1"]
                    <partial name="_Flor" />
                    @Textos["general.atributo-2"]
                    <partial name="_Flor" />
                    @Textos["general.atributo-3"]
                </p>
                <div class="acciones">
                    <a class="boton boton--claro" href="/Sobre">@Textos["portada.boton-sobre"]</a>
                </div>
            </div>
            <img class="casita-grande" src="~/img/marca/casita.png" alt="" width="380" height="447" />
        </div>
    </div>
</section>

<div class="transicion" style="background:var(--petroleo)"><partial name="_Onda" model="@("var(--durazno)")" /></div>
}
else
{
    <div class="transicion" style="background:var(--crema)"><partial name="_Onda" model="@("var(--durazno)")" /></div>
}

<section class="banda banda--durazno banda--ajustada" style="padding-top:calc(var(--aire) * .35)">
    <div class="contenedor">
        <div class="suscripcion">
            <partial name="_BloqueBuzon" model="Model.Buzon" />
            <img class="kiosco" src="~/img/marca/kiosquito.webp" alt="" width="320" height="315" loading="lazy" />
        </div>
    </div>
</section>
