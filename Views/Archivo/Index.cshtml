@model ArchivoVm
@{
    string Enlace(string? barrio, int pagina) =>
        Url.Action("Index", "Archivo", new { barrio, pagina = pagina > 1 ? pagina : (int?)null })!;
}

<section class="encabezado banda--crema">
    <div class="contenedor">
        <img class="adorno" src="~/img/marca/ventana-3.webp" alt="" width="300" height="417" />
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">@Textos["archivo.titulo"]</h1>
        @if (Textos["archivo.bajada"] is { Length: > 0 })
        {
            <p class="bajada">@Textos.ConEnlaces("archivo.bajada")</p>
        }
    </div>
</section>

<section class="banda banda--crema" style="padding-top:0">
    <div class="contenedor">
        <nav class="filtros" aria-label="@Model.T("Filtrar por barrio", "Filter by neighbourhood", "Filtrar por bairro")">
            <a class="filtro" href="@Enlace(null, 1)" aria-current="@(Model.BarrioActivo is null ? "page" : null)">@Textos["archivo.filtro-todos"]</a>
            @foreach (var b in Model.Barrios)
            {
                <a class="filtro" href="@Enlace(b, 1)" aria-current="@(Model.BarrioActivo == b ? "page" : null)">@b</a>
            }
        </nav>

        @if (Model.Fichas.Count == 0)
        {
            <p class="bajada">@Textos.ConEnlaces("archivo.vacio")</p>
        }
        else
        {
            <div class="archivo">
                @foreach (var f in Model.Fichas)
                {
                    <a class="ficha" href="@f.Url">
                        <div class="ficha-foto">
                            <img src="@f.ImagenSrc" alt="@f.ImagenAlt" loading="lazy" />
                        </div>
                        <span class="ficha-num">@f.NumeroFormateado</span>
                        <b>@f.Titulo</b>
                        <em>@f.Barrio · @f.Fecha.ToString("d 'de' MMMM")</em>
                    </a>
                }
            </div>
        }

        @if (Model.TotalPaginas > 1)
        {
            <nav class="paginacion" aria-label="@Model.T("Paginación", "Pagination", "Paginação")">
                @foreach (var n in Model.PaginasVisibles)
                {
                    <a href="@Enlace(Model.BarrioActivo, n)" aria-current="@(n == Model.Pagina ? "page" : null)">@n</a>
                }
                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a href="@Enlace(Model.BarrioActivo, Model.Pagina + 1)">@Textos["archivo.siguiente"]</a>
                }
            </nav>
        }
    </div>
</section>

@if (Textos.Enlace("archivo.mapa") is { } mapa)
{
    <section class="banda banda--crema2" aria-labelledby="titulo-mapa">
        <div class="contenedor">
            <h2 class="titulo-seccion" id="titulo-mapa">@Textos["archivo.mapa-titulo"]</h2>
            @if (Textos["archivo.mapa-bajada"] is { Length: > 0 })
            {
                <p class="bajada">@Textos.ConEnlaces("archivo.mapa-bajada")</p>
            }
            <div class="mapa mapa--archivo">
                <iframe src="@mapa" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        title="@Textos["archivo.mapa-titulo"]"></iframe>
            </div>
        </div>
    </section>
}
