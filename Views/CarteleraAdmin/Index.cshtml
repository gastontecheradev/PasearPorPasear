@model List<AficheVm>
@{
    Layout = "_AdminLayout";
    var pegados = Model.Count(a => a.Estado == EstadoAfiche.Publicado && a.TieneImagen && !a.EstaVencido);
}

<div class="admin-titulo">
    <div>
        <h1>Cartelera de barrio</h1>
        <p>
            @(pegados == 1 ? "1 afiche pegado" : $"{pegados} afiches pegados") en el sitio.
            @if (pegados == 0)
            {
                <text>Mientras no haya ninguno, se ve la cartelera vacía con el correo para mandar afiches.</text>
            }
        </p>
    </div>
    <div class="admin-acciones">
        <a class="boton boton--principal" href="/Admin/Cartelera/Nuevo">Subir un afiche</a>
    </div>
</div>

<div class="admin-barra">
    <input class="buscador" type="search" placeholder="Buscar por nombre o por lo que dice…" aria-label="Buscar" />
</div>

@if (Model.Count == 0)
{
    <p class="admin-vacio">Todavía no subiste ningún afiche.</p>
}
else
{
    <div class="admin-tabla-envoltura">
        <table class="admin-tabla">
            <thead>
                <tr>
                    <th style="width:64px"></th>
                    <th>Afiche</th>
                    <th style="width:130px">Vigencia</th>
                    <th style="width:120px">Estado</th>
                    <th style="width:270px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var vencido = a.EstaVencido;
                    <tr>
                        <td>
                            @if (a.TieneImagen)
                            {
                                <img class="admin-miniatura admin-miniatura--afiche" src="@a.ImagenSrc" alt="" loading="lazy" />
                            }
                        </td>
                        <td>
                            <span class="principal">@a.Titulo</span>
                            @if (!a.TieneImagen)
                            {
                                <span class="secundario">Sin imagen: no se muestra hasta que le subas una.</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(a.ImagenAlt))
                            {
                                <span class="secundario">@(a.ImagenAlt.Length > 70 ? a.ImagenAlt.Substring(0, 70) + "…" : a.ImagenAlt)</span>
                            }
                        </td>
                        <td>
                            @if (a.VigenteHasta is null)
                            {
                                <text>sin fecha</text>
                            }
                            else if (vencido)
                            {
                                <text>venció @a.VigenteHasta.Value.ToString("dd/MM")</text>
                            }
                            else
                            {
                                <text>hasta @a.VigenteHasta.Value.ToString("dd/MM")</text>
                            }
                        </td>
                        <td>
                            @if (a.Estado == EstadoAfiche.Archivado)
                            {
                                <span class="pastilla pastilla--vencido">Archivado</span>
                            }
                            else if (vencido)
                            {
                                <span class="pastilla pastilla--vencido">Vencido</span>
                            }
                            else
                            {
                                <span class="pastilla pastilla--activo">Pegado</span>
                            }
                        </td>
                        <td>
                            @if (a.Estado == EstadoAfiche.Archivado)
                            {
                                <form method="post" action="/Admin/Cartelera/Estado/@a.Id" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="estado" value="@((int)EstadoAfiche.Publicado)" />
                                    <button type="submit" class="boton boton--principal boton--chico">Volver a pegar</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/Admin/Cartelera/Estado/@a.Id" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="estado" value="@((int)EstadoAfiche.Archivado)" />
                                    <button type="submit" class="boton boton--borde boton--chico">Archivar</button>
                                </form>
                            }
                            <a class="boton boton--borde boton--chico" href="/Admin/Cartelera/Editar/@a.Id">Editar</a>
                            <form method="post" action="/Admin/Cartelera/Borrar/@a.Id" style="display:inline"
                                  data-confirmar="¿Borrar «@a.Titulo»? No se puede deshacer.">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="boton boton--peligro boton--chico">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
