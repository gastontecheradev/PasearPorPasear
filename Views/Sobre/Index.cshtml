@model SobreVm
@{
    var esIngles = Model.Idioma == "en";
    var esPortugues = Model.Idioma == "pt";
}

<section class="banda banda--crema" aria-labelledby="sobre-proyecto">
    <div class="contenedor">
        <div class="duo">
            <div>
                <div class="regla regla--izq"><partial name="_Flor" /></div>
                <h1 class="titulo-seccion" id="sobre-proyecto">@Model.Titulo</h1>
                <div class="texto" style="margin-top:20px">
                    @Html.Raw(Model.Contenido)
                </div>
                <p class="atributos" style="color:var(--petroleo)">
                    @(esPortugues ? "Movimento" : esIngles ? "Movement" : "Movimiento")
                    <partial name="_Flor" />
                    @(esPortugues ? "Curiosidade" : esIngles ? "Curiosity" : "Curiosidad")
                    <partial name="_Flor" />
                    @(esPortugues ? "Identidade" : esIngles ? "Identity" : "Identidad")
                </p>
            </div>
            @if (!string.IsNullOrEmpty(Model.ProyectoImagenSrc))
            {
                <div class="columna-retrato columna-retrato--der">
                    <div class="retrato">
                        <img src="@Model.ProyectoImagenSrc" alt="@Model.Pagina.ProyectoImagenAlt" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ContenidoAutora))
{
    <section class="banda banda--crema2" aria-labelledby="sobre-autora">
        <div class="contenedor">
            <div class="duo">
                @if (!string.IsNullOrEmpty(Model.ImagenSrc))
                {
                    <div class="columna-retrato">
                        <div class="retrato">
                            <img src="@Model.ImagenSrc" alt="@Model.Pagina.ImagenAlt" />
                        </div>
                    </div>
                }
                <div>
                    <h2 class="titulo-seccion" id="sobre-autora">@Model.Pagina.Firma</h2>
                    <div class="texto" style="margin-top:20px">
                        @Html.Raw(Model.ContenidoAutora)
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<div class="transicion" style="background:@(string.IsNullOrWhiteSpace(Model.ContenidoAutora) ? "var(--crema)" : "var(--crema-2)")"><partial name="_Onda" model="@("var(--petroleo)")" /></div>

<section class="banda banda--petroleo banda--ajustada" style="padding-top:calc(var(--aire) * .35)">
    <div class="contenedor">
        <div class="suscripcion">
            <div>
                <h2 class="titulo-seccion" style="font-size:var(--t-xl)">@(esPortugues ? "Gosta do projeto? Você pode colaborar com o “envelope virtual”." : esIngles ? "Do you like the project? You can chip in to the “virtual envelope”." : "¿Te gusta el proyecto? Podés colaborar “al sobre virtual”.")</h2>
                <p class="bajada">@(esPortugues ? "Este projeto se sustenta com tempo, cafezinho e muito amor. Se quiser colaborar com o que puder e quiser, pode fazer isso aqui:" : esIngles ? "This project runs on time, coffee and a lot of love. If you'd like to chip in whatever you can, you can do it here:" : "Este proyecto se sostiene con tiempo, cafecito y mucho amor. Si querés colaborar con lo que puedas, quieras, podés hacerlo acá:")</p>
                <div class="acciones">
                    <a class="boton boton--claro" href="https://link.mercadopago.com.uy/pasearporpasear" target="_blank" rel="noopener">@(esPortugues ? "Deixar uma gorjeta" : esIngles ? "Leave a tip" : "Dejar una propina")</a>
                </div>
            </div>
            <img class="kiosco" src="~/img/marca/kiosquito.webp" alt="" width="320" height="315" loading="lazy" />
        </div>
    </div>
</section>
