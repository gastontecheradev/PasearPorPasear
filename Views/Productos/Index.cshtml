@model ProductosVm
@{
    // Mientras la sección está en construcción no se muestra la grilla de productos.
    // Se cambia desde el panel: Productos, Textos de la página.
    var enConstruccion = Textos.Activo("productos.en-construccion");
    var bajada = Textos["productos.bajada"];
}

<section class="encabezado banda--crema">
    <div class="contenedor">
        <img class="adorno" src="~/img/marca/ventana-2.webp" alt="" width="300" height="379" />
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">@Textos["productos.titulo"]</h1>
        @if (!enConstruccion && !string.IsNullOrEmpty(bajada))
        {
            <p class="bajada">@Textos.ConEnlaces("productos.bajada")</p>
        }
    </div>
</section>

<section class="banda banda--crema" style="padding-top:0">
    <div class="contenedor">
        @if (enConstruccion)
        {
            <div class="en-construccion">
                <h2>@Textos["productos.construccion-titulo"]</h2>
                <p>@Textos.ConEnlaces("productos.construccion-texto")</p>
            </div>
        }
        else
        {
        <div class="productos">
            @foreach (var p in Model.Productos)
            {
                <article class="producto @p.ClasePanel">
                    <div class="producto-imagen">
                        <img src="@p.ImagenSrc" alt="@p.ImagenAlt" loading="lazy" />
                    </div>
                    <div class="producto-cuerpo">
                        <h2>@p.Titulo</h2>
                        @if (!string.IsNullOrEmpty(p.Descripcion))
                        {
                            <p>@Html.Raw(PasearPorPasear.Services.TextoConFormato.EnUnParrafo(p.Descripcion))</p>
                        }
                        <div class="precio">
                            @if (p.Estado == EstadoProducto.DescargaGratis)
                            {
                                <b>@Textos["productos.gratis"]</b>
                                <a class="boton boton--borde" href="@(p.ArchivoUrl ?? "/Contacto")">@Textos["productos.descargar"]</a>
                            }
                            else if (p.Estado == EstadoProducto.ALaVenta)
                            {
                                <b>$ @p.Precio?.ToString("N0")</b>
                                <a class="boton boton--principal" href="/Contacto">@Textos["productos.pedir"]</a>
                            }
                            else
                            {
                                <b>@Textos["productos.pronto"]</b>
                                <span class="pendiente" style="margin:0">@Textos["productos.en-preparacion"]</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <div style="margin-top:52px">
            <partial name="_BloqueBuzon" model="Model.Buzon" />
        </div>
        }
    </div>
</section>
