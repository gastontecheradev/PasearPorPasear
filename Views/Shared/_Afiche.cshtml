@model AficheVm
@*
    Afiche de la cartelera: la imagen que armó Rosalía sobre la plantilla.
    El texto va dentro de la imagen y en el muro queda chico, así que el
    afiche entero enlaza a la imagen en grande.
*@
<a class="afiche" href="@Model.ImagenSrc">
    <img src="@Model.ImagenSrc" alt="@Model.Alt" width="1080" height="1350" loading="lazy" />
</a>
