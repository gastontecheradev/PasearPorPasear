@model CarteleraAfiche
@{
    Layout = "_AdminLayout";
    var esNuevo = Model.Id == 0;
    // Un afiche nuevo todavía no tiene URL: si el formulario volvió con un
    // error, la imagen elegida no se guardó y hay que elegirla de nuevo.
    var guardada = !esNuevo && Model.ImagenDatos is { Length: > 0 };
}

<div class="admin-titulo">
    <div>
        <h1>@(esNuevo ? "Afiche nuevo" : Model.Titulo)</h1>
        <p>El afiche se sube ya armado sobre la plantilla de la cartelera.</p>
    </div>
    <div class="admin-acciones">
        <a class="boton boton--borde" href="/Admin/Cartelera">Volver al listado</a>
    </div>
</div>

<form method="post" action="/Admin/Cartelera/Guardar" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div asp-validation-summary="All" class="aviso aviso--error" role="alert"></div>

    <div class="admin-form">
        <div>
            <div class="admin-panel">
                <h2>El afiche</h2>
                <p>En la cartelera se ve la imagen tal cual la subas.</p>

                <div class="admin-afiche">
                    <div class="admin-afiche-vista">
                        @if (guardada)
                        {
                            <img src="@Model.ImagenSrc" alt="" width="1080" height="1350" />
                        }
                        else
                        {
                            <div class="sin-imagen">Todavía sin imagen</div>
                        }
                    </div>

                    <div>
                        <div class="campo">
                            <label for="imagen">@(guardada ? "Reemplazar la imagen" : "Imagen del afiche")</label>
                            <input id="imagen" name="imagen" type="file"
                                   accept="image/jpeg,image/png,image/webp,image/gif" required="@(!guardada)" />
                            <p class="pista">
                                La plantilla ya terminada, en vertical como la original (1080 × 1350).
                                JPG, PNG, WEBP o GIF, hasta 6 MB.
                            </p>
                        </div>

                        <div class="campo">
                            <label for="Titulo">Nombre</label>
                            <input id="Titulo" name="Titulo" type="text" value="@Model.Titulo" required maxlength="120" />
                            <p class="pista">Para reconocerlo en el listado. No se ve en el sitio.</p>
                        </div>

                        <div class="campo">
                            <label for="ImagenAlt">Qué dice el afiche</label>
                            <textarea id="ImagenAlt" name="ImagenAlt" maxlength="300" style="min-height:110px">@Model.ImagenAlt</textarea>
                            <p class="pista">
                                Lo leen quienes usan lector de pantalla: qué es, cuándo y dónde, en pocas palabras.
                                Si lo dejás vacío, se usa el nombre.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="admin-panel admin-panel--lateral">
                <h2>Publicación</h2>
                <p>Se ve en el sitio si está pegado y no venció.</p>

                <div class="campo">
                    <label for="Estado">Estado</label>
                    <select id="Estado" name="Estado">
                        <option value="@((int)EstadoAfiche.Publicado)" selected="@(Model.Estado == EstadoAfiche.Publicado)">Pegado en la cartelera</option>
                        <option value="@((int)EstadoAfiche.Archivado)" selected="@(Model.Estado == EstadoAfiche.Archivado)">Archivado</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="VigenteHasta">Vigente hasta</label>
                    <input id="VigenteHasta" name="VigenteHasta" type="date"
                           value="@(Model.VigenteHasta?.ToString("yyyy-MM-dd"))" />
                    <p class="pista">Al día siguiente se despega solo. Dejalo vacío si no vence, como un oficio.</p>
                </div>

                <div class="campo">
                    <label for="Orden">Orden</label>
                    <input id="Orden" name="Orden" type="number" value="@Model.Orden" />
                    <p class="pista">Más chico, más arriba en el muro. Con el mismo número, el más nuevo primero.</p>
                </div>

                <button class="boton boton--principal" type="submit" style="width:100%;justify-content:center">
                    @(esNuevo ? "Pegar el afiche" : "Guardar cambios")
                </button>
            </div>
        </div>
    </div>
</form>
