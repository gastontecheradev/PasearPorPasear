@model CarteleraVm
@{
    var correo = Textos["general.correo"];
    string Enlace(string? categoria) => Url.Action("Index", "Cartelera", new { categoria })!;
}

<section class="encabezado banda--crema">
    <div class="contenedor">
        <img class="adorno" src="~/img/marca/gorrion.webp" alt="" width="380" height="307" />
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">@Textos["cartelera.titulo"]</h1>
        @if (Textos["cartelera.bajada"] is { Length: > 0 } bajada)
        {
            <p class="bajada">@bajada</p>
        }
    </div>
</section>

<section class="banda banda--mostaza banda--ajustada">
    <div class="contenedor">
        <h2 style="font-size:var(--t-xl)">@Textos["cartelera.como-titulo"]</h2>
        <ol class="pasos">
            <li>
                <h3>@Textos["cartelera.paso1-titulo"]</h3>
                <p>@Textos.ConCorreo("cartelera.paso1-texto")</p>
            </li>
            <li>
                <h3>@Textos["cartelera.paso2-titulo"]</h3>
                <p>@Textos["cartelera.paso2-texto"]</p>
            </li>
            <li>
                <h3>@Textos["cartelera.paso3-titulo"]</h3>
                <p>@Textos["cartelera.paso3-texto"]</p>
            </li>
        </ol>
    </div>
</section>

<section class="banda banda--crema2">
    <div class="contenedor">
        @if (Model.HayAfiches)
        {
            <nav class="filtros" aria-label="@Model.T("Filtrar por categoría", "Filter by category", "Filtrar por categoria")">
                <a class="filtro" href="@Enlace(null)" aria-current="@(Model.CategoriaActiva is null ? "page" : null)">@Textos["cartelera.filtro-todos"]</a>
                @foreach (var c in CategoriasAfiche.Todas)
                {
                    <a class="filtro" href="@Enlace(c.Slug)" aria-current="@(Model.CategoriaActiva == c.Categoria ? "page" : null)">@Textos[c.ClaveTexto]</a>
                }
            </nav>
        }

        @if (!Model.HayAfiches)
        {
            @* Sin afiches queda pegada la plantilla vacía, que ya dice cómo mandar uno. *@
            <div class="muro muro--vacio">
                <div class="afiche">
                    <img src="~/img/cartelera/cartelera-vacia.png" width="1080" height="1350"
                         alt="@Textos["cartelera.vacia"].Replace("{correo}", correo)" />
                </div>
            </div>
        }
        else if (Model.Afiches.Count == 0)
        {
            <p class="bajada">@Textos["cartelera.vacia-categoria"]</p>
        }
        else
        {
            <div class="muro">
                @foreach (var a in Model.Afiches)
                {
                    <partial name="_Afiche" model="a" />
                }
            </div>

            @* Afiche en grande sin salir de la página. Lo abre site.js; sin JS, el enlace abre la imagen. *@
            <dialog class="afiche-grande" id="afiche-grande" aria-label="@Model.T("Afiche en grande", "Enlarged poster", "Cartaz ampliado")">
                <button type="button" class="afiche-grande-cerrar" data-cerrar>@Textos["cartelera.cerrar"]</button>
                <img src="" alt="" width="1080" height="1350" />
            </dialog>
        }
    </div>
</section>
