@model ContactoVm
@{
    var correo = Textos["general.correo"];
    var whatsapp = Textos.Enlace("general.whatsapp");
    var instagram = Textos.Enlace("general.instagram");
    var formulario = Textos.Enlace("general.buzon-formulario");
}

<section class="encabezado banda--crema">
    <div class="contenedor">
        <img class="adorno" src="~/img/marca/ventana-3.webp" alt="" width="300" height="417" />
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">@Textos["contacto.titulo"]</h1>
        @if (Textos["contacto.bajada"] is { Length: > 0 } bajada)
        {
            <p class="bajada">@bajada</p>
        }
    </div>
</section>

<section class="banda banda--crema" style="padding-top:0">
    <div class="contenedor">
        <div class="contacto">
            @* Suscripción al buzón: formulario de MailerLite embebido (trae su propio título y texto). *@
            @if (formulario is not null)
            {
                <div id="buzon" class="formulario-externo">
                    <iframe src="@formulario"
                            loading="lazy"
                            title="@Model.T("Formulario de suscripción al buzón de la Casita", "Sign-up form for the Casita mailbox", "Formulário de inscrição na caixa de correio da Casita")"></iframe>
                </div>
            }

            <ul class="datos">
                <li>
                    <strong>@Textos["contacto.etiqueta-correo"]</strong>
                    <a href="mailto:@correo">@correo</a>
                </li>
                @if (instagram is not null)
                {
                    <li>
                        <strong>Instagram</strong>
                        <a href="@instagram" target="_blank" rel="noopener">@Textos["general.instagram-usuario"]</a>
                    </li>
                }
                @if (whatsapp is not null)
                {
                    <li>
                        <strong>WhatsApp</strong>
                        <a href="@whatsapp" target="_blank" rel="noopener">@Textos["general.pie-whatsapp"]</a>
                    </li>
                }
                <li>
                    <strong>@Textos["contacto.etiqueta-donde"]</strong>
                    @Textos["contacto.donde"]
                </li>
            </ul>
        </div>
    </div>
</section>