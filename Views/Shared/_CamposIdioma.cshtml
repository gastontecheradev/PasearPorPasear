@model PasearPorPasear.ViewModels.CamposIdiomaVm
@*
    Un mismo campo en español, inglés y portugués. Qué idioma se ve lo
    decide el selector de la página (_SelectorIdioma), no cada campo.
    El español es obligatorio; si falta una traducción, la vista pública
    cae al español, así que no pasa nada por dejarlas vacías.
    En inglés y portugués se muestra el texto en español como referencia;
    admin.js lo mantiene al día con lo que se esté escribiendo.
*@
@{
    var tieneEs = !string.IsNullOrWhiteSpace(Model.Es);

    void Panel(string idioma, string sufijo, string? valor, string? enIdioma)
    {
        var id = Model.Id + sufijo;
        var nombre = Model.NombreDe(sufijo);
        <div class="idioma-panel campo" data-idioma="@idioma" hidden="@(idioma != "es")">
            <label for="@id" id="@(id)-etiqueta">
                @Model.Etiqueta
                @if (enIdioma is not null)
                {
                    <span class="idioma-marca">en @enIdioma</span>
                }
            </label>
            @if (Model.Largo)
            {
                @* Con data-editor, admin.js lo cambia a la vista por el editor de texto
                   y lo deja oculto: sigue siendo lo que se envía. *@
                <textarea id="@id" name="@nombre" maxlength="@Model.Maximo" class="@Model.ClaseLargo"
                          data-editor="@(Model.Enlaces ? (Model.Parrafos ? "parrafos" : "renglones") : null)">@valor</textarea>
                if (Model.Enlaces)
                {
                    @* Sin JavaScript se explica el formato; admin.js cambia este texto por el del editor. *@
                    <p class="pista" data-editor-ayuda>
                        @(Model.Parrafos ? "Cada renglón es un párrafo, y los renglones en blanco también se ven." : "Los renglones, también los que quedan en blanco, se ven igual en la página.")
                        Para un enlace: [el texto](https://la-direccion), o [el texto](/Paseos) para una página del sitio.
                    </p>
                }
            }
            else
            {
                <input id="@id" name="@nombre" type="text" value="@valor" maxlength="@Model.Maximo" />
            }

            @if (enIdioma is null)
            {
                if (!string.IsNullOrEmpty(Model.Pista))
                {
                    <p class="pista">@Model.Pista</p>
                }
            }
            else
            {
                if (Model.Largo)
                {
                    <details class="original" data-original hidden="@(!tieneEs)">
                        <summary>Ver el texto en español</summary>
                        <div class="original-texto" data-original-texto>@Model.Es</div>
                    </details>
                }
                else
                {
                    <p class="original" data-original hidden="@(!tieneEs)">
                        <b>En español:</b> <span data-original-texto>@Model.Es</span>
                    </p>
                }
                <p class="pista">Si queda vacío, en @enIdioma se muestra el español.</p>
            }
        </div>
    }
}
<div class="idioma-campo" data-campo>
    @{ Panel("es", "", Model.Es, null); }
    @{ Panel("en", "En", Model.En, "inglés"); }
    @{ Panel("pt", "Pt", Model.Pt, "portugués"); }
</div>
