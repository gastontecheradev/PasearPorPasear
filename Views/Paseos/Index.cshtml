@model PaseosVm
@{
    var esIngles = Model.Idioma == "en";
    var esPortugues = Model.Idioma == "pt";
}

<section class="encabezado banda--crema">
    <div class="contenedor">
        <img class="adorno" src="~/img/marca/ventana-1.webp" alt="" width="280" height="474" />
        <div class="regla regla--izq"><partial name="_Flor" /></div>
        <h1 class="titulo-seccion">@Model.TituloSeccion</h1>
        @if (!string.IsNullOrEmpty(Model.BajadaSeccion))
        {
            <p class="bajada">@Model.BajadaSeccion</p>
        }
    </div>
</section>

<section class="banda banda--crema" style="padding-top:0">
    <div class="contenedor">
        <div class="propuestas">
            @foreach (var p in Model.Propuestas)
            {
                <article class="propuesta">
                    @if (!string.IsNullOrEmpty(p.ImagenSrc))
                    {
                        <div class="propuesta-foto">
                            <img src="@p.ImagenSrc" alt="@p.ImagenAlt" loading="lazy" />
                        </div>
                    }
                    <div class="propuesta-cuerpo">
                        @if (!string.IsNullOrEmpty(p.Etiqueta))
                        {
                            <span class="etiqueta">@p.Etiqueta</span>
                        }
                        <h2>@p.Titulo</h2>
                        <div class="@(p.PendienteDeDefinir ? "por-definir" : "")">
                            @Html.Raw(p.DescripcionHtml)
                        </div>

                        @if (p.PendienteDeDefinir)
                        {
                            <span class="pendiente">@(esPortugues ? "Falta definir o conteúdo" : esIngles ? "Content still to be defined" : "Falta definir el contenido")</span>
                        }
                        else
                        {
                            @if (p.Datos.Count > 0)
                            {
                                <div class="datos-paseo">
                                    @foreach (var d in p.Datos)
                                    {
                                        <div><b>@d.Valor</b><span>@d.Etiqueta</span></div>
                                    }
                                </div>
                            }
                            <div class="acciones" style="margin-top:22px">
                                @if (p.Enlace?.StartsWith("http") == true)
                                {
                                    <a class="boton boton--principal" href="@p.Enlace" target="_blank" rel="noopener">@p.TextoEnlace</a>
                                }
                                else
                                {
                                    <a class="boton boton--principal" href="@p.Enlace">@p.TextoEnlace</a>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

