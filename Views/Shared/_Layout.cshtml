@inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var culture = requestCulture?.RequestCulture?.Culture?.TwoLetterISOLanguageName ?? "es";
    var isEn = culture == "en";
    var isPt = culture == "pt";

    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    Func<string, string?> activo = c => controlador == c ? "page" : null;

    var esAdmin = SignInManager.IsSignedIn(User) && User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Pasear por Pasear</title>

    @* Precarga de los dos pesos que aparecen sobre el pliegue *@
    <link rel="preload" href="~/fonts/golos-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/golos-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/marca/favicon.png" />

    @await RenderSectionAsync("Styles", required: false)

    <noscript>
        <style>
            /* Sin JavaScript el desplegable no puede abrirse: se deja el menú a la vista */
            @@media (max-width:1100px){
                .nav{display:flex}
                .hamburguesa{display:none}
            }
        </style>
    </noscript>

    <meta name="theme-color" content="#FFF5E6" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Pasear por Pasear")" />
    <meta property="og:description" content="@Textos["general.descripcion"]" />
    <meta property="og:image" content="https://pasearporpasear.com/img/marca/og-image.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@culture" />
</head>
<body>

<a class="saltar" href="#contenido">@(isPt ? "Ir ao conteúdo" : isEn ? "Skip to content" : "Ir al contenido")</a>

<!-- ══════════════ CABECERA ══════════════ -->
<header class="cabecera">
    <div class="cabecera-int">
        @* En la cabecera va sólo la casita: el lettering vive en la portada y en el pie *@
        <a class="marca" href="/">
            <img class="casita" src="~/img/marca/casita-sm.webp" alt="Pasear por Pasear" width="120" height="141" />
        </a>

        <ul class="nav" id="nav">
            <li><a href="/" aria-current="@activo("Home")">@Textos["general.menu-inicio"]</a></li>
            <li><a href="/Sobre" aria-current="@activo("Sobre")">@Textos["general.menu-sobre"]</a></li>
            <li><a href="/Paseos" aria-current="@activo("Paseos")">@Textos["general.menu-paseos"]</a></li>
            <li><a href="/Archivo" aria-current="@activo("Archivo")">@Textos["general.menu-archivo"]</a></li>
            <li><a href="/Productos" aria-current="@activo("Productos")">@Textos["general.menu-productos"]</a></li>
            <li><a href="/Cartelera" aria-current="@activo("Cartelera")">@Textos["general.menu-cartelera"]</a></li>
            <li><a href="/Contacto" aria-current="@activo("Contacto")">@Textos["general.menu-contacto"]</a></li>
        </ul>

        <div class="idiomas" role="group" aria-label="@(isPt ? "Idioma" : isEn ? "Language" : "Idioma")">
            <button type="button" onclick="setLanguage('es')" aria-pressed="@(culture == "es" ? "true" : "false")">ES</button>
            <button type="button" onclick="setLanguage('en')" aria-pressed="@(culture == "en" ? "true" : "false")">EN</button>
            <button type="button" onclick="setLanguage('pt')" aria-pressed="@(culture == "pt" ? "true" : "false")">PT</button>
        </div>

        <button class="hamburguesa" id="hamburguesa" aria-expanded="false" aria-controls="nav"
                aria-label="@(isPt ? "Abrir menu" : isEn ? "Open menu" : "Abrir menú")">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

@* Token para el cambio de idioma por JS *@
<form id="langForm" hidden>@Html.AntiForgeryToken()</form>

@if (TempData["Success"] is string ok || TempData["Error"] is string err || TempData["Info"] is string info)
{
    <div class="contenedor" style="margin-top:20px">
        @if (TempData["Success"] is string s1) { <p class="aviso aviso--ok" role="status">@s1</p> }
        @if (TempData["Error"] is string s2) { <p class="aviso aviso--error" role="alert">@s2</p> }
        @if (TempData["Info"] is string s3) { <p class="aviso aviso--info" role="status">@s3</p> }
    </div>
}

<main id="contenido">
    @RenderBody()
</main>

<!-- ══════════════ PIE ══════════════ -->
<footer class="pie">
    <div class="contenedor">
        <div class="pie-grilla">
            <div>
                <img class="lettering" src="~/img/marca/wordmark-crema.webp" alt="Pasear por Pasear" width="720" height="307" />
                <p>@Textos.ConEnlaces("general.pie-lema")</p>
            </div>
            <div>
                <h4>@Textos["general.pie-recorrer"]</h4>
                <ul>
                <li><a href="/Sobre">@Textos["general.menu-sobre"]</a></li>
                <li><a href="/Paseos">@Textos["general.menu-paseos"]</a></li>
                <li><a href="/Archivo">@Textos["general.menu-archivo"]</a></li>
                <li><a href="/Cartelera">@Textos["general.pie-cartelera"]</a></li>
                </ul>
            </div>
            <div>
                <h4>@Textos["general.pie-escribir"]</h4>
                <ul>
                <li><a href="/Contacto">@Textos["general.menu-contacto"]</a></li>
                <li><a href="/Productos">@Textos["general.menu-productos"]</a></li>
                <li><a href="mailto:@Textos["general.correo"]?subject=cartelera%20de%20barrio">@Textos["general.pie-afiche"]</a></li>
                <li><a href="/Contacto#buzon">@Textos["general.pie-buzon"]</a></li>
                </ul>
            </div>
            <div>
                <h4>@Textos["general.pie-seguir"]</h4>
                <ul>
                    @if (Textos.Enlace("general.instagram") is string instagram)
                    {
                        <li><a href="@instagram" target="_blank" rel="noopener">Instagram</a></li>
                    }
                    @await Component.InvokeAsync("CanalWhatsApp")
                </ul>
            </div>
        </div>

        <div class="pie-abajo">
            <span>© @DateTime.Now.Year @Textos["general.pie-firma"]</span>
            <span>
                @if (esAdmin)
                {
                    <a href="/Admin">Admin</a>
                    <span style="margin:0 8px;opacity:.5">·</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        <button type="submit" class="pie-salir">@(isPt ? "Sair" : isEn ? "Log out" : "Salir")</button>
                    </form>
                    <span style="margin:0 8px;opacity:.5">·</span>
                }
                else
                {
                    <a href="/Account/Login">Admin</a>
                    <span style="margin:0 8px;opacity:.5">·</span>
                }
                @Textos["general.pie-identidad"]
            </span>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
